# Port HTTP exposé sur l'hôte
LBM_PORT=8080

# Sous-chemin optionnel derrière un reverse proxy / ProxyPass (ex. /livebox — vide = racine /)
BASE_PATH=

# Mode Démo au premier démarrage (true = simulation sans Livebox réelle)
DEMO_MODE=false

# Connexion Livebox (optionnel ici — vous pouvez aussi les saisir dans l'IHM Web,
# où ils sont enregistrés dans le coffre chiffré AES-256-GCM sur /data)
LIVEBOX_URL=http://192.168.1.1/
LIVEBOX_USER=admin
LIVEBOX_PASSWORD=

# URL incluse dans les emails d'alerte pour ouvrir le tableau de bord
DASHBOARD_URL=http://localhost:8080

# Clé maître pour le chiffrement AES-256-GCM des identifiants (laisser vide pour auto-génération sur /data/.master.key)
# Exemple : openssl rand -base64 32
LBM_MASTER_KEY=

# Configuration SMTP optionnelle (aussi configurable dans l'IHM Web)
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_ALLOW_INSECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=livebox-monitor@local
SMTP_TO=
